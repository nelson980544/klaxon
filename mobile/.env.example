# Clés PUBLIQUES de Supabase — elles ne donnent aucun privilège :
# tout ce qu'un compte peut lire ou écrire est décidé par la base (RLS).
# Copier ce fichier en .env et remplir avec les valeurs du projet.
EXPO_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon
